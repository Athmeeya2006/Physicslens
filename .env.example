# Copy to .env and fill in. NEVER commit .env. NEVER paste keys into chats or screenshots.

# Meta Model API key (dev.meta.ai -> API keys). Format: LLM_<id>_<secret>
MODEL_API_KEY=

# Open-weight reasoning. demo and prod accept only these providers and never fall back to the Meta API.
#   baseten  = Muse Spark Open served by Baseten (primary)
#   glimmer  = Muse Glimmer 30B on our own llama-server (also the fallback for baseten when GLIMMER_BASE_URL is set)
#   together = Muse Glimmer 30B hosted by Together AI
REASONING_PROVIDER=baseten
BASETEN_API_KEY=
GLIMMER_BASE_URL=
GLIMMER_API_KEY=

# dev | demo | prod
APP_ENV=dev

# 1 = fake model responses for automated tests only. The app refuses to start with this in demo/prod.
MOCK_MODELS=0

# 1 = use muse-spark-1.3-contributor (cheaper, Meta may train on data) in dev, if the account has access
USE_CONTRIBUTOR_MODEL=1

# 1 = block every paid API call immediately (same as creating a .KILL file)
PHYSICSLENS_KILL=0

# Access code for live mode on the public deployment (give to judges in the submission notes)
DEMO_ACCESS_CODE=

# 1 = let public visitors (no access code) analyze one short clip under public_daily_cap_usd; 0 = gallery only
PUBLIC_TRY_ENABLED=1
