{
  "name": "physicslens-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npm run worker && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "build:static": "npm run worker && STATIC_EXPORT=1 next build",
    "worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@types/leaflet": "1.9.22",
    "katex": "0.19.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.17"
  }
}
